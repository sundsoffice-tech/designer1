{
  "name": "ss-messebau-configurator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ai": "node -e \"process.env.VITE_ENABLE_AI_ASSISTANT='true'; process.env.VITE_ENABLE_VOICE_ASSISTANT='true'; require('vite/bin/vite.js')\"",
    "dev:admin": "node -e \"process.env.VITE_ENABLE_ADMIN_PANEL='true'; require('vite/bin/vite.js')\"",
    "dev:sales": "node -e \"process.env.VITE_ENABLE_CAMERA_TOOLS='true'; require('vite/bin/vite.js')\"",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "api": "node server/index.js",
    "test": "jest",
    "test:unit": "jest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "@react-three/postprocessing": "^3.0.4",
    "@react-three/rapier": "^2.2.0",
    "@react-three/xr": "^6.6.28",
    "camera-controls": "^3.1.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "multer": "^1.4.5-lts.1",
    "i18next": "^25.6.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "jspdf": "^3.0.4",
    "sharp": "^0.33.5",
    "openai": "^6.9.1",
    "postprocessing": "^6.38.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.3.5",
    "sat": "^0.9.0",
    "three": "^0.181.1",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "npm:rolldown-vite@7.2.2",
    "vite-plugin-pwa": "^1.1.0"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.2"
  }
}
