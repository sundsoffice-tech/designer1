{
  "name": "ss-stand-configurator-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:frontend": "pnpm --filter @ss/frontend dev",
    "build:frontend": "pnpm --filter @ss/frontend build",
    "test:frontend": "pnpm --filter @ss/frontend test",
    "dev:backend": "pnpm --filter @ss/backend start",
    "lint:frontend": "pnpm --filter @ss/frontend lint",
    "typecheck:frontend": "pnpm --filter @ss/frontend typecheck"
  }
}
