OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1-mini
PORT=4000
# Comma-separated list, e.g. http://localhost:5173,http://localhost:4173
CORS_ORIGIN=http://localhost:5173

# Persistence for saved booth configs
CONFIG_TTL_HOURS=8
CONFIG_STORE_MAX=1000
CONFIG_PURGE_INTERVAL_MINUTES=5
CONFIG_STORE_DIR=./server/data

# Pricing source (file, DB, or headless CMS)
PRICING_DATA_FILE=./server/shared/data/pricing.json
PRICING_API_URL=
PRICING_API_TOKEN=
PRICING_CACHE_MINUTES=5

# Optional customer profile id for personalized pricing
VITE_CUSTOMER_ID=

# Skip runtime API calls (use reine Frontend-Berechnung)
VITE_DISABLE_RUNTIME=false
