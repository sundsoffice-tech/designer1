  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'CMD=\"$CLAUDE_TOOL_INPUT\"; if echo \"$CMD\" | grep -qE \"rm\\s+-rf\\s+/|git\\s+push\\s+--force\\s+.*main|DROP\\s+TABLE|DROP\\s+DATABASE\"; then echo \"BLOCKED: Destructive command detected\" >&2; exit 2; fi; exit 0'",
            "statusMessage": "Security check..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'FILE=\"$CLAUDE_FILE_PATH\"; if [[ \"$FILE\" == *.ts || \"$FILE\" == *.tsx ]]; then cd \"$CLAUDE_PROJECT_DIR/ss-messebau-configurator\" && npx eslint --fix \"$FILE\" 2>/dev/null; fi; exit 0'",
            "statusMessage": "Auto-linting...",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd \"$CLAUDE_PROJECT_DIR/ss-messebau-configurator\" && pnpm --filter @ss/frontend typecheck 2>&1 || (echo \"VETO: TypeScript-Fehler! Fixe diese bevor du beendest.\" >&2 && exit 2)'",
            "statusMessage": "TypeScript Sentinel validating..."
          }
        ]
      }
    ]
  }
